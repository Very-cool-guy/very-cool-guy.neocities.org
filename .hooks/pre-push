#!/usr/bin/env zsh
cd $(git rev-parse --show-toplevel)
sed -i '' -e '$ d' .gitignore
trap 'z neo; echo "**/node_modules" >> .gitignore' SIGINT
rsync -a -r --delete --exclude .git --exclude scripts/gen_postlist --exclude scripts/boiler.beam . ../actualsite # built scripts prolly have hard-coded file positions
cd ../actualsite
scripts/gen_postlist
cd scripts; erl -noshell -run boiler main; cd ../
git add .
git commit -m "meow" &>/dev/null
echo scripts/cljs/node_modules/**/* | python -c "print('neocities push -e',' -e '.join(input().split(' ')),' .')" | zsh # will have to do until they merge my pr :(
cd ../very-cool-guy.neocities.org
echo "**/node_modules" >> .gitignore
