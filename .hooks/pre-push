#!/usr/bin/env zsh
cd $(git rev-parse --show-toplevel)
sed -i '' -e '$ d' .gitignore
rsync -a -r --delete --exclude .git --exclude scripts/gen_postlist . ../actualsite # crystal has to be built there to ensure correct __FILE__
cd ../actualsite
scripts/gen_postlist
git add .
git commit -m "meow" &>/dev/null
neocities push .
cd ../very-cool-guy.neocities.org
echo "**/node_modules" >> .gitignore
